{
  "expo": {
    "name": "Excelência Operacional (EO)",
    "slug": "eo",
    "version": "1.0.0",
    "scheme": "eo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.appeo.mobile",
      "buildNumber": "13",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appeo.mobile",
      "versionCode": 12,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-updates",
      "expo-router",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "calendarPermission": "Permita que o EO adicione eventos quando você pedir.",
          "writeOnlyCalendarPermission": "Permita que o EO adicione eventos à agenda quando você pedir."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o EO fotografe evidências dos checklists.",
          "photosPermission": "Permita que o EO escolha evidências para os checklists."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1b9d38c0-be49-44cf-9783-a179dd812713",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "product": "Excelência Operacional",
      "router": {},
      "eas": {
        "projectId": "1b9d38c0-be49-44cf-9783-a179dd812713"
      }
    },
    "owner": "controlalls-team"
  }
}
