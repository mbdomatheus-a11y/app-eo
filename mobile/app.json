{
  "expo": {
    "name": "Excelência Operacional (EO)",
    "slug": "eo",
    "version": "1.0.0",
    "scheme": "eo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.appeo.mobile",
      "buildNumber": "19",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "icon": "./assets/eo-icon.png",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.appeo.mobile",
      "versionCode": 19,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/eo-adaptive-foreground.png",
        "backgroundColor": "#4A4E58"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permita que o EO use Face ID para desbloquear sua sessão com segurança."
        }
      ],
      "expo-updates",
      "expo-router",
      [
        "expo-notifications",
        {
          "mode": "production",
          "sounds": [
            "./assets/sounds/eo_soft.wav",
            "./assets/sounds/eo_bell.wav",
            "./assets/sounds/eo_alert.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "calendarPermission": "Permita que o EO adicione eventos quando você pedir.",
          "writeOnlyCalendarPermission": "Permita que o EO adicione eventos à agenda quando você pedir."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o EO fotografe evidências dos checklists.",
          "photosPermission": "Permita que o EO escolha evidências para os checklists."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o EO grave seu relato de vendas por até um minuto.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o EO leia códigos de barras e registre evidências quando você solicitar.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o EO ouça seu ditado quando você solicitar.",
          "speechRecognitionPermission": "Permita que o EO transforme sua fala em texto para sua revisão."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita registrar sua localização ao responder um checklist, somente com seu consentimento."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1b9d38c0-be49-44cf-9783-a179dd812713",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "product": "Excelência Operacional",
      "router": {},
      "eas": {
        "projectId": "1b9d38c0-be49-44cf-9783-a179dd812713"
      }
    },
    "owner": "controlalls-team",
    "icon": "./assets/eo-icon.png"
  }
}
